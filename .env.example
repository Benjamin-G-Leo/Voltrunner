# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# Use the publishable (anon) key only. Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Turn on "Forgot password" only after you set up an email service (SMTP) in Supabase -> Authentication.
# VITE_PASSWORD_RESET=on
